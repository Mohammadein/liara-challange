# این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
# .env هرگز commit نمی‌شود.

# --- سرویس هوش مصنوعی لیارا ---
# baseUrl را از کنسول لیارا > هوش مصنوعی بردارید. شکلش این‌طوری است:
LIARA_AI_BASE_URL=https://ai.liara.ir/api/v1/xxxxxxxxxxxxxxxxxxxxxxxx
LIARA_AI_API_KEY=

# --- مدل‌ها ---
# ⚠️ این اسم‌ها باید با مدل‌های فعال در پلن شما در کنسول لیارا تطبیق داده شوند.
MODEL_ANSWER=openai/gpt-4o-mini
MODEL_FAST=openai/gpt-4o-mini
MODEL_EMBEDDING=openai/text-embedding-3-small

# --- حالت اجرا ---
# true = پاسخ‌های ساختگی بدون تماس با LLM (برای کار روی UI)
USE_MOCK=true

# --- تنظیمات ---
TOP_K=8
MAX_MESSAGE_CHARS=2000
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_LLM_REQUESTS=8
LLM_TIMEOUT_SECONDS=75
REQUEST_TIMEOUT_SECONDS=120
# روی لیارا true کنید؛ فقط چون reverse proxy لیارا header را sanitize می‌کند.
TRUST_PROXY_HEADERS=false
# اختیاری: اگر پر شود، /metrics فقط با Authorization: Bearer قابل دسترسی است.
METRICS_TOKEN=
LOG_LEVEL=INFO

# برای ماندگاری بین deployها، این مسیر را روی Liara Disk قرار دهید.
SESSION_DB_PATH=data/sessions.db
