# این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
# .env هرگز commit نمی‌شود.

# --- سرویس هوش مصنوعی لیارا ---
# baseUrl را از کنسول لیارا > هوش مصنوعی بردارید. شکلش این‌طوری است:
LIARA_AI_BASE_URL=https://ai.liara.ir/api/v1/xxxxxxxxxxxxxxxxxxxxxxxx
LIARA_AI_API_KEY=

# --- مدل‌ها ---
# ⚠️ این اسم‌ها باید با مدل‌های فعال در پلن شما در کنسول لیارا تطبیق داده شوند.
MODEL_ANSWER=openai/gpt-4o-mini
MODEL_FAST=openai/gpt-4o-mini
MODEL_EMBEDDING=openai/text-embedding-3-small

# --- حالت اجرا ---
# true = پاسخ‌های ساختگی بدون تماس با LLM (برای کار روی UI)
USE_MOCK=true

# --- تنظیمات ---
TOP_K=5
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
